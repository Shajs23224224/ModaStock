APP_NAME=ModaStock API
API_V1_PREFIX=/api/v1
APP_ENV=development
DATABASE_URL=postgresql+psycopg://modastock:change-me@localhost:5432/modastock
CORS_ORIGINS=http://localhost:5173
# Reemplaza por un secreto aleatorio criptográficamente seguro de al menos 32 caracteres.
# El valor DEV-ONLY solo es válido en desarrollo/pruebas.
JWT_SECRET_KEY=DEV-ONLY-CHANGE-THIS-SECRET-KEY-32-CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=30
